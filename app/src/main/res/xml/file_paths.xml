<?xml version="1.0" encoding="utf-8"?>
<!-- Keep in sync with Updater.downloadDir(): downloaded APKs must live under
     this root or FileProvider refuses to build a URI for the installer. -->
<paths>
    <cache-path name="updates" path="updates/" />
    <!-- Keep in sync with TrafficExport.cacheDir(): exported captures are
         shared from this root, so the two names must not drift apart. -->
    <cache-path name="traffic" path="traffic/" />
</paths>
